<Window x:Class="ClassRoom_Control.Views.Student.StudentMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сообщение от преподавателя"
        Width="500" Height="260"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="{StaticResource MainFont}">

    <Border Background="{StaticResource BgDarkerBrush}"
            BorderBrush="{StaticResource AccentBlueBrush}"
            BorderThickness="2"
            CornerRadius="16"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#5865f2" Opacity="0.4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentBlueMutedBrush}"
                        Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📢" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Сообщение от преподавателя" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Внимание ко всей аудитории" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Content text -->
            <Border Grid.Row="1" Background="{StaticResource BgInputBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="MessageBodyText" Text="Текст сообщения"
                               FontSize="15" LineHeight="22"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- Button -->
            <Button Grid.Row="2" Content="Понятно" Height="38" Width="140" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
        </Grid>
    </Border>
</Window>
