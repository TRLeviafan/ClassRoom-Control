<UserControl x:Class="ClassRoom_Control.Views.Student.StudentModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgMediumBrush}">

    <Grid>
        <!-- Center card -->
        <Border Background="{StaticResource BgDarkBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BgLightBrush}" BorderThickness="1"
                Padding="36,32" MaxWidth="520"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <!-- Monitor Icon with glow -->
                <Border Width="80" Height="80" CornerRadius="40"
                        Background="{StaticResource AccentBlueMutedBrush}"
                        BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="2"
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="💻" FontSize="34"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Student machine name -->
                <TextBlock x:Name="MachineNameText"
                           Text="Компьютер ученика"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>

                <TextBlock Text="Клиент ClassRoom Control активен"
                           FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <!-- Connection status card -->
                <Border Background="{StaticResource BgDarkerBrush}" CornerRadius="8"
                        Padding="16,14" Margin="0,0,0,24"
                        BorderBrush="{StaticResource BgLightBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="StatusDot" Grid.Column="0"
                                 Width="12" Height="12" Fill="{StaticResource StatusYellowBrush}"
                                 Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusTitleText"
                                       Text="Поиск преподавателя..."
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="StatusSubtitleText"
                                       Text="Авто-обнаружение через UDP broadcast в локальной сети"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Demo status info box -->
                <Border Background="{StaticResource BgDarkerBrush}" CornerRadius="8"
                        Padding="16,12" Margin="0,0,0,28">
                    <StackPanel>
                        <TextBlock Text="Текущее состояние:"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="DemoStateText"
                                   Text="Ожидание трансляции урока"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource AccentBlueLightBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                            Content="Свернуть в трей" Click="MinimizeToTray_Click"
                            Padding="16,10" FontSize="13"/>

                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                            Content="Сменить роль" Click="ChangeRole_Click"
                            Padding="16,10" FontSize="13"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>