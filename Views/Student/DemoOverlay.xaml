<Window x:Class="ClassRoom_Control.Views.Student.DemoOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClassRoom Control — Демонстрация"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{StaticResource BgDarkestBrush}"
        FontFamily="{StaticResource MainFont}">

    <Grid>
        <!-- Layer 1: Video/Screen Frame surface -->
        <Image x:Name="ScreenImage"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- Layer 2: Waiting / Overlay Info banner (shown when demo is active but stream is connecting) -->
        <Grid x:Name="WaitingPanel" Background="{StaticResource BgDarkestBrush}" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Glowing Accent circle with monitor icon -->
                <Border Width="90" Height="90" CornerRadius="45"
                        Background="{StaticResource AccentBlueMutedBrush}"
                        BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="2"
                        HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="🖥️" FontSize="36"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="OverlayTitleText"
                           Text="Идёт демонстрация экрана"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <TextBlock x:Name="OverlaySubtitleText"
                           Text="Преподаватель транслирует свой экран. Ввод временно заблокирован."
                           FontSize="15"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <!-- Subtle loader dots -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBlueBrush}" Margin="4,0"/>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBlueLightBrush}" Margin="4,0"/>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBlueDarkBrush}" Margin="4,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Layer 3: Attention / Lock Screen Overlay (Режим "Внимание на преподавателя") -->
        <Grid x:Name="LockPanel" Background="#111214" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="90" Height="90" CornerRadius="45"
                        Background="#f23f4333"
                        BorderBrush="{StaticResource StatusRedBrush}" BorderThickness="2"
                        HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="🔒" FontSize="36"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="LockTitleText"
                           Text="Внимание на преподавателя"
                           FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock x:Name="LockMessageText"
                           Text="Пожалуйста, оторвитесь от экрана и обратите внимание на доску."
                           FontSize="16"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <Border Background="{StaticResource BgDarkBrush}" CornerRadius="6"
                        Padding="14,8" HorizontalAlignment="Center">
                    <TextBlock Text="Компьютер заблокирован преподавателем"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>