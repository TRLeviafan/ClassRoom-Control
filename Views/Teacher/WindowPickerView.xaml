<Window x:Class="ClassRoom_Control.Views.Teacher.WindowPickerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выберите окно для трансляции" Height="480" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource MainFont}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Border Background="{StaticResource BgDarkerBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentBlueBrush}"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="🖥️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Трансляция экрана" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Выберите экран или конкретное окно" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Отмена" Click="BtnCancel_Click"/>
            </Grid>

            <!-- Windows List -->
            <ListBox x:Name="WindowsList" Grid.Row="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="WindowsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScreen}" Value="True">
                                                <Setter Property="Source" Value="{x:Null}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            
                            <!-- Fallback for Screen Icon -->
                            <TextBlock Text="🖥️" FontSize="20" Width="24" TextAlignment="Center" Margin="0,0,12,0"
                                       Visibility="{Binding IsScreen, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource SecondaryButton}" 
                        Width="105" Height="40" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnStart" Content="Начать трансляцию" Style="{StaticResource PrimaryButton}" 
                        Height="40" Padding="22,0" IsEnabled="False" Click="BtnStart_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
