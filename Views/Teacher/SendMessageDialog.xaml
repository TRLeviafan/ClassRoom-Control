<Window x:Class="ClassRoom_Control.Views.Teacher.SendMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отправить сообщение"
        Width="500" Height="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource MainFont}">

    <Border Background="{StaticResource BgDarkerBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentBlueBrush}"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="💬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="DialogTitleText" Text="Отправить сообщение классу" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="DialogTargetText" Text="Сообщение появится у всех подключенных учеников со звуковым сигналом" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Закрыть окно" Click="Close_Click"/>
            </Grid>

            <!-- Text Box -->
            <TextBox x:Name="MessageInput" Grid.Row="1"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     FontSize="14"
                     VerticalScrollBarVisibility="Auto"
                     ToolTip="Введите текст объявления или задания для учеников"
                     Margin="0,0,0,16"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}"
                        Width="105" Height="40" Margin="0,0,10,0" Click="Close_Click"/>

                <Button Content="Отправить" Style="{StaticResource PrimaryButton}"
                        Width="140" Height="40" Click="Send_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
