<Window x:Class="ClassRoom_Control.Views.Teacher.PublishLessonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Публикация записи урока"
        Icon="/app.ico"
        Width="550" Height="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource MainFont}">

    <Border Background="{StaticResource BgDarkerBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentBlueBrush}"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="🎬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Запись урока готова!" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="FileInfoSubtitle" Text="Размер: 142 МБ • Длительность: 42:15" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Закрыть окно" Click="Close_Click"/>
            </Grid>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Lesson Topic -->
                    <TextBlock Text="Тема урока:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="LessonTopicInput" Height="38" FontSize="14"
                             ToolTip="Укажите тему урока (будет в заголовке публикации в Telegram)"
                             Margin="0,0,0,16"/>

                    <!-- Group Selection -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Учебная группа / Класс:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="+ Новая группа" HorizontalAlignment="Right"
                                Background="Transparent" Foreground="{StaticResource AccentBlueLightBrush}"
                                BorderThickness="0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                ToolTip="Добавить новый класс и привязать его канал"
                                Click="NewGroup_Click"/>
                    </Grid>
                    <ComboBox x:Name="GroupsCombo" Height="38" DisplayMemberPath="Name" Margin="0,0,0,16"
                              ToolTip="Выберите класс, которому адресовано видео"/>

                    <!-- Cloud Copy Option -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <CheckBox x:Name="ChkCloudCopy" Content="Скопировать в папку Google Диска / Облака" IsChecked="True"
                                      ToolTip="Файл будет скопирован в папку синхронизации Google Диска"
                                      FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="26,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CloudRootPathInput" Height="34" FontSize="12"
                                         ToolTip="Путь к локальной папке Google Диска на компьютере"/>
                                <Button Grid.Column="1" Content="Обзор..." Width="80" Height="34" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Padding="0"
                                        ToolTip="Выбрать папку на диске" Click="BrowseCloud_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Telegram Publish Option -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <CheckBox x:Name="ChkTelegramPublish" Content="Опубликовать в Telegram-канал группы" IsChecked="True"
                                      FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Если видео меньше 50 МБ — бот отправит сам MP4 файл, если больше — информационный пост со ссылкой на облако."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="26,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Status Text -->
                    <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Только сохранить на диск" Style="{StaticResource SecondaryButton}"
                        Height="40" Padding="18,0" Margin="0,0,10,0"
                        ToolTip="Оставить файл в локальной папке записей без отправки"
                        Click="Skip_Click"/>

                <Button x:Name="BtnPublish" Content="Опубликовать" Style="{StaticResource PrimaryButton}"
                        Width="170" Height="40" Click="Publish_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
