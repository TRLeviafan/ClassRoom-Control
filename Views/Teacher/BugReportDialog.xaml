<Window x:Class="ClassRoom_Control.Views.Teacher.BugReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сообщить об ошибке"
        Icon="/app.ico"
        Width="520" Height="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource MainFont}">

    <Border Background="{StaticResource BgDarkerBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentBlueBrush}"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="🐛" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Баг-репорт разработчику" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Сообщение будет отправлено напрямую автору программы в Telegram" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Закрыть окно" Click="Close_Click"/>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="Категория проблемы:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CategoryCombo" Height="36" Margin="0,0,0,12" ToolTip="Выберите тип проблемы для быстрой сортировки">
                    <ComboBoxItem Content="🐞 Ошибка в работе программы (сбой / вылет)" Tag="#Crash" IsSelected="True"/>
                    <ComboBoxItem Content="✈️ Проблема с Telegram (бот / отправка в канал)" Tag="#TelegramIssue"/>
                    <ComboBoxItem Content="☁️ Проблема с Google Диском / папкой облака" Tag="#CloudIssue"/>
                    <ComboBoxItem Content="💡 Пожелание / Идея по улучшению" Tag="#FeatureRequest"/>
                    <ComboBoxItem Content="❓ Другой вопрос или проблема" Tag="#Other"/>
                </ComboBox>

                <TextBlock Text="Что пошло не так? Опишите ситуацию:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="MessageInput" Height="85" TextWrapping="Wrap" AcceptsReturn="True"
                         ToolTip="Опишите ваши действия перед возникновением ошибки"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Технические подробности (ошибки, стек, детали):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="DetailsInput" Height="60" FontFamily="Consolas" FontSize="11"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         ToolTip="Системная информация (заполняется автоматически при сбоях)"/>

                <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}"
                        Width="105" Height="40" Margin="0,0,10,0" Click="Close_Click"/>

                <Button x:Name="BtnSend" Content="Отправить автору" Style="{StaticResource PrimaryButton}"
                        Width="180" Height="40" Click="Send_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
