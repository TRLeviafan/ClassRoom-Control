<Window x:Class="ClassRoom_Control.Views.Teacher.AddGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить учебную группу"
        Width="550" Height="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource MainFont}">

    <Border Background="{StaticResource BgDarkerBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentBlueBrush}"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="👥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Добавление группы / класса" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Привязка Telegram-канала и локальной папки Google Диска" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Закрыть окно" Click="Close_Click"/>
            </Grid>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Group Name -->
                    <TextBlock Text="Название группы:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="GroupNameInput" Height="38" FontSize="14"
                             ToolTip="Например: 9 «А» класс или Группа 204"
                             Margin="0,0,0,14"/>

                    <!-- Instruction Card for Teachers -->
                    <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource AccentBlueMutedBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="💡 Как настроить отправку в Telegram (2 простых шага):"
                                       FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlueLightBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="1. Создайте канал/группу для учеников и добавьте бота в Администраторы:"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,4" TextWrapping="Wrap"/>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                <TextBlock Text="Имя бота: " FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BotUsernameLabel" Text="@ClassRoomControlBot" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBlueLightBrush}" Cursor="Hand"
                                           ToolTip="Нажмите для копирования" MouseDown="BotUsernameLabel_MouseDown"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="📋 Скопировать" Height="24" MinHeight="24" Padding="6,0" FontSize="11"
                                        Background="{StaticResource BgLighterBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                        Click="CopyBotName_Click" ToolTip="Скопировать имя бота для поиска в Telegram" Margin="0,0,4,0"/>
                                <Button Content="↗ В Telegram" Height="24" MinHeight="24" Padding="6,0" FontSize="11"
                                        Background="{StaticResource AccentBlueMutedBrush}" Foreground="{StaticResource AccentBlueLightBrush}"
                                        Click="OpenBotTelegram_Click" ToolTip="Открыть бота в Telegram"/>
                            </WrapPanel>
                            <TextBlock Text="2. Введите юзернейм канала (@channel_name) ИЛИ нажмите кнопку ниже для автопоиска."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Auto Discover Button -->
                    <Button x:Name="BtnAutoDiscover" Height="40" Margin="0,0,0,10"
                            Background="{StaticResource AccentBlueMutedBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            ToolTip="Бот сам найдёт недавние чаты, куда его добавили администратором"
                            Cursor="Hand" Click="AutoDiscover_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Найти группу автоматически (из недавних)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Discovered Groups Combobox (initially collapsed) -->
                    <StackPanel x:Name="DiscoveredPanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="🎯 Выберите найденный чат/группу из списка:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueLightBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="DiscoveredCombo" Height="38" SelectionChanged="DiscoveredCombo_SelectionChanged"
                                  ToolTip="Выберите нужный чат из списка">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="💬 " FontSize="12" Foreground="{StaticResource AccentBlueLightBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Telegram Target Input -->
                    <TextBlock Text="Имя канала (@channel_name) или ID чата:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TelegramTargetInput" Height="38" FontSize="14"
                             ToolTip="Публичный юзернейм канала (напр. @school_class_10) или числовой ID чата (напр. -100123456789)"
                             Margin="0,0,0,14"/>

                    <!-- Cloud Subfolder -->
                    <TextBlock Text="Подпапка на Google Диске (необязательно):" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="CloudFolderInput" Height="38" FontSize="14"
                             ToolTip="Имя папки внутри Google Диска, куда сохранять видео этого класса (напр. 9А)"
                             Margin="0,0,14,0"/>

                    <!-- Status / Error Text -->
                    <TextBlock x:Name="StatusMsgText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Button Content="🐛 Баг-репорт" Width="120" Height="40" HorizontalAlignment="Left"
                        Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                        ToolTip="Написать разработчику, если возникли сложности с настройкой"
                        Click="ReportBug_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Style="{StaticResource SecondaryButton}"
                            Width="105" Height="40" Margin="0,0,10,0" Click="Close_Click"/>

                    <Button x:Name="BtnSave" Content="Сохранить группу" Style="{StaticResource PrimaryButton}"
                            Width="180" Height="40" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
