<UserControl x:Class="ClassRoom_Control.Views.Teacher.RecordingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource MainFont}">

    <Grid Background="{StaticResource BgDarkerBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgDarkBrush}" Padding="32,20"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentBlueBrush}"
                            Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="🎬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Записи уроков" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="RecordingsSummaryText" Text="Загрузка списка записей..." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔄 Обновить" Style="{StaticResource SecondaryButton}"
                            Height="40" Padding="16,0" Margin="0,0,10,0"
                            ToolTip="Пересканировать папку записей"
                            Click="Refresh_Click"/>

                    <Button Content="📁 Открыть папку записей" Style="{StaticResource PrimaryButton}"
                            Height="40" Padding="18,0"
                            ToolTip="Открыть папку с видео в проводнике Windows"
                            Click="OpenFolder_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="32,20">
            <!-- Empty state -->
            <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="📹" FontSize="54" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.5"/>
                <TextBlock Text="Пока нет сохранённых записей" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Нажмите «Начать запись» во время демонстрации урока, чтобы сохранить видео."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Recordings List -->
            <ScrollViewer x:Name="RecordingsScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RecordingsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="18,14" Margin="0,0,0,10"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Video Icon -->
                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="{StaticResource BgDarkerBrush}"
                                            Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="🎥" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DateFormatted}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,14,0"/>
                                            <TextBlock Text="{Binding FileSizeFormatted}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,14,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="▶ Воспроизвести" Height="38" Padding="14,0" Margin="0,0,8,0"
                                                Background="{StaticResource AccentBlueMutedBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                                ToolTip="Открыть в стандартном плеере Windows"
                                                Click="Play_Click" Tag="{Binding FilePath}"/>

                                        <Button Content="📤 Опубликовать" Style="{StaticResource PrimaryButton}"
                                                Height="38" Padding="14,0" Margin="0,0,8,0"
                                                ToolTip="Отправить в Telegram или сохранить в Google Диск"
                                                Click="Publish_Click" Tag="{Binding FilePath}"/>

                                        <Button Content="📁 В папке" Style="{StaticResource SecondaryButton}"
                                                Height="38" Padding="14,0" Margin="0,0,8,0"
                                                ToolTip="Показать файл в Проводнике Windows"
                                                Click="OpenInFolder_Click" Tag="{Binding FilePath}"/>

                                        <Button Content="🗑" Width="38" Height="38"
                                                Background="Transparent" Foreground="{StaticResource StatusRedBrush}"
                                                ToolTip="Удалить файл с диска"
                                                Click="Delete_Click" Tag="{Binding FilePath}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
