<UserControl x:Class="ClassRoom_Control.Views.Teacher.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource MainFont}">

    <Grid Background="{StaticResource BgDarkerBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with vibrant Blue Badge (Matching Start Demo Button) -->
        <Border Grid.Row="0" Background="{StaticResource BgDarkBrush}" Padding="32,20"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentBlueBrush}"
                        Margin="0,0,14,0" VerticalAlignment="Center">
                    <Path Data="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.43,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.74,8.87c-0.12,0.21 -0.08,0.47 0.12,0.61l2.03,1.58C4.84,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94z M12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6s1.62,-3.6 3.6,-3.6s3.6,1.62 3.6,3.6S13.98,15.6 12,15.6z"
                          Fill="White" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Настройки приложения" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Конфигурация Telegram, облачных хранилищ, видеопотока и автозапуска" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Settings Form ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,24">
            <StackPanel MaxWidth="840" HorizontalAlignment="Left">

                <!-- 1. Telegram & Groups -->
                <TextBlock Text="✈️ Telegram и учебные группы" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Centralized Official Bot Card (No token typing needed for teachers!) -->
                        <Border Background="{StaticResource BgDarkerBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Blue Bot Icon -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="{StaticResource AccentBlueBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="🤖" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Bot Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                        <TextBlock Text="Единый Telegram-бот: " FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        
                                        <TextBlock x:Name="BotUsernameText" Text="@ClassRoomControlBot" FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBlueLightBrush}" Cursor="Hand"
                                                   ToolTip="Нажмите, чтобы скопировать @юзернейм"
                                                   MouseDown="BotUsername_MouseDown" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                        <!-- Copy Button -->
                                        <Button x:Name="BtnCopyBot" Height="26" MinHeight="26" Padding="8,0" Margin="0,0,6,0"
                                                Background="{StaticResource BgLighterBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                                ToolTip="Скопировать юзернейм бота" Click="CopyBotUsername_Click"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📋" FontSize="11" Margin="0,0,4,0"/>
                                                <TextBlock Text="Копировать" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Open in Telegram Button -->
                                        <Button x:Name="BtnOpenTelegram" Height="26" MinHeight="26" Padding="8,0" Margin="0,0,8,0"
                                                Background="{StaticResource AccentBlueMutedBrush}" Foreground="{StaticResource AccentBlueLightBrush}"
                                                ToolTip="Открыть бота в Telegram (t.me/...)" Click="OpenBotInTelegram_Click"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="↗" FontSize="11" FontWeight="Bold" Margin="0,0,4,0"/>
                                                <TextBlock Text="В Telegram" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <Border CornerRadius="4" Background="{StaticResource AccentBlueMutedBrush}" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock x:Name="BotStatusBadge" Text="✓ Активен" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueLightBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="Преподавателям не нужно создавать ботов. Просто добавьте этого бота в канал или группу класса администратором."
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Test Button -->
                                <Button Grid.Column="2" Content="Проверить связь" Style="{StaticResource SecondaryButton}"
                                        Height="36" Padding="14,0" Margin="10,0,0,0" VerticalAlignment="Center"
                                        ToolTip="Проверить доступность Telegram Bot API" Click="CheckToken_Click"/>
                            </Grid>
                        </Border>

                        <!-- Groups Manager Section -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Ваши учебные группы и классы:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Content="+ Добавить группу" HorizontalAlignment="Right"
                                    Background="Transparent" Foreground="{StaticResource AccentBlueLightBrush}"
                                    BorderThickness="0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                    ToolTip="Привязать канал или группу вашего класса"
                                    Click="AddGroup_Click"/>
                        </Grid>
                        <ListBox x:Name="GroupsListBox" Height="120" Margin="0,0,0,12"
                                 ToolTip="Список ваших локальных учебных групп">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="👥 "/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding TelegramTarget}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource CloseButton}" Content="✕" Width="26" Height="26" Margin="10,0,0,0"
                                                ToolTip="Удалить группу из списка" Click="RemoveGroup_Click" Tag="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Action Bar under Groups -->
                        <Grid Margin="0,4,0,0">
                            <Button Content="🐛 Написать разработчику" HorizontalAlignment="Left"
                                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" FontSize="12" Cursor="Hand"
                                    ToolTip="Отправить сообщение разработчику при любой ошибке или предложении"
                                    Click="OpenBugReport_Click"/>

                            <Button x:Name="BtnToggleDevSettings" Content="⚙️ Расширенные настройки бота" HorizontalAlignment="Right"
                                    Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                                    BorderThickness="0" FontSize="11" Cursor="Hand"
                                    ToolTip="Показать собственный токен и ID разработчика"
                                    Click="ToggleDevSettings_Click"/>
                        </Grid>

                        <!-- Hidden Dev Settings Panel (Expanded only if requested) -->
                        <Border x:Name="DevSettingsPanel" Visibility="Collapsed" Background="{StaticResource BgDarkerBrush}"
                                CornerRadius="10" Padding="14" Margin="0,12,0,0"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Собственный токен бота (оставьте пустым для использования единого бота):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="TelegramTokenInput" Height="36" FontSize="13" Margin="0,0,0,12"
                                         ToolTip="Оставьте пустым для работы через стандартного официального бота"/>

                                <TextBlock Text="ID чата разработчика (для отправки баг-репортов):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="DeveloperChatIdInput" Height="36" FontSize="13"
                                         ToolTip="Числовой ID чата разработчика для приёма отчётов"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. Cloud Storage & Retention -->
                <TextBlock Text="☁️ Облачное хранилище и очистка" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Cloud Folder -->
                        <TextBlock Text="Корневая папка Google Диска / Яндекс.Диска:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CloudFolderInput" Height="38" FontSize="13"
                                     ToolTip="Локальный путь к папке Google Диска на этом компьютере"/>
                            <Button Grid.Column="1" Content="Обзор..." Width="100" Height="38" Margin="10,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Выбрать папку на диске"
                                    Click="BrowseCloudFolder_Click"/>
                        </Grid>

                        <CheckBox x:Name="ChkAutoCopyCloud" Content="Автоматически копировать записи в папку облака"
                                  FontWeight="SemiBold" Margin="0,0,0,14"
                                  ToolTip="При завершении записи видео будет сразу копироваться в облако"/>

                        <!-- Auto-Cleanup -->
                        <Border Background="{StaticResource BgDarkerBrush}" CornerRadius="10" Padding="14"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="ChkAutoCleanup" Content="Автоматически удалять старые записи на диске (защита от переполнения)"
                                          FontWeight="SemiBold" Margin="0,0,0,8"
                                          ToolTip="Очищает локальные видеозаписи уроков старше выбранного срока"/>
                                <StackPanel Orientation="Horizontal" Margin="30,0,0,0">
                                    <TextBlock Text="Хранить записи не дольше:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="RetentionDaysCombo" Width="170" Height="34"
                                              ToolTip="Минимальный безопасный срок хранения — 30 дней">
                                        <ComboBoxItem Content="30 дней (месяц)" Tag="30" IsSelected="True"/>
                                        <ComboBoxItem Content="60 дней (2 месяца)" Tag="60"/>
                                        <ComboBoxItem Content="90 дней (четверть)" Tag="90"/>
                                        <ComboBoxItem Content="180 дней (полгода)" Tag="180"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. Screen Demo & Video Quality -->
                <TextBlock Text="🖥️ Демонстрация экрана и производительность" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,24">
                    <StackPanel>
                        <CheckBox x:Name="ChkEnablePreview" Content="Предпросмотр демонстрации экрана (Discord-style: виден только при активном окне)"
                                  FontWeight="SemiBold" Margin="0,0,0,14"
                                  ToolTip="Скрывает окно предпросмотра при сворачивании для максимальной экономии ресурсов GPU/CPU"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Частота кадров (FPS):" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="FpsCombo" Height="36" ToolTip="Частота кадров стриминга ученикам">
                                    <ComboBoxItem Content="15 FPS (Экономный трафик)" Tag="15"/>
                                    <ComboBoxItem Content="30 FPS (Рекомендуется)" Tag="30" IsSelected="True"/>
                                    <ComboBoxItem Content="60 FPS (Максимальная плавность)" Tag="60"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Битрейт видео H.264:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="BitrateCombo" Height="36" ToolTip="Битрейт видеоряда (качество сжатия)">
                                    <ComboBoxItem Content="2 Мбит/с (Слабая сеть)" Tag="2"/>
                                    <ComboBoxItem Content="4 Мбит/с (Стандарт 1080p)" Tag="4" IsSelected="True"/>
                                    <ComboBoxItem Content="8 Мбит/с (Высокое качество)" Tag="8"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. System, Version & Updates -->
                <TextBlock Text="⚙️ Система, версия и обновления" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,24">
                    <StackPanel>
                        <CheckBox x:Name="ChkStartup" Content="Запускать ClassRoom Control при старте Windows"
                                  FontWeight="SemiBold" Margin="0,0,0,18"
                                  ToolTip="Добавить приложение в автозапуск через реестр Windows"/>

                        <Border Background="{StaticResource BgDarkerBrush}" CornerRadius="10" Padding="16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <!-- Title & Version Badge -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="ClassRoom Control" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Border CornerRadius="4" Background="{StaticResource AccentBlueMutedBrush}" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="v0.0.1r" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlueLightBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Developer Info with Link -->
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                        <TextBlock Text="Разработчик: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Левиафан" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Height="24" MinHeight="24" Padding="8,0" FontSize="11"
                                                Background="{StaticResource AccentBlueMutedBrush}" Foreground="{StaticResource AccentBlueLightBrush}"
                                                ToolTip="Связаться с автором в Telegram" Click="OpenDeveloperTelegram_Click" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💬" FontSize="11" Margin="0,0,4,0"/>
                                                <TextBlock Text="Telegram автора" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>

                                    <TextBlock Text="Сетевое ПО для управления компьютерными классами и дистанционного обучения" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>

                                <!-- Update Button -->
                                <Button Grid.Column="1" Height="40" Padding="18,0" Margin="16,0,0,0"
                                        Style="{StaticResource PrimaryButton}"
                                        ToolTip="Проверить наличие свежих версий на GitHub"
                                        Click="CheckUpdates_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Проверить обновления" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Save Button Bar -->
        <Border Grid.Row="2" Background="{StaticResource BgDarkBrush}" Padding="32,16"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                <Button Content="💾 Сохранить настройки" HorizontalAlignment="Right" Height="42" Padding="26,0"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="Применить и сохранить все изменения"
                        Click="SaveSettings_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
