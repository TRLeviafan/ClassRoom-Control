<UserControl x:Class="ClassRoom_Control.Views.Teacher.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgMediumBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT SIDEBAR ═══ -->
        <Border Grid.Column="0" Background="{StaticResource BgDarkBrush}"
                BorderBrush="{StaticResource BgLightBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header (Row 0) -->
                <Border Grid.Row="0" Padding="16,16,16,14"
                        BorderBrush="{StaticResource BgLightBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="ClassRoom Control"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource StatusGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Режим преподавателя"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sidebar Menu (Row 1) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,10,8,10">
                        <!-- Dashboard Nav item -->
                        <Border x:Name="NavDashboard" CornerRadius="6" Background="{StaticResource AccentBlueMutedBrush}"
                                Padding="12,10" Margin="0,2" Cursor="Hand" MouseDown="NavDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavDashboardText" Text="Dashboard" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Notes Nav item (Заметки) -->
                        <Border x:Name="NavNotes" CornerRadius="6" Background="Transparent"
                                Padding="12,10" Margin="0,2" Cursor="Hand" MouseDown="NavNotes_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavNotesText" Text="Заметки" FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Recording Nav item -->
                        <!-- Recordings Nav item -->
                        <Border x:Name="NavRecordings" CornerRadius="6" Padding="12,10" Margin="0,2" Cursor="Hand"
                                MouseLeftButtonUp="NavRecordings_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎬" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavRecordingsText" Text="Записи" FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Settings Nav item -->
                        <Border x:Name="NavSettings" CornerRadius="6" Padding="12,10" Margin="0,2" Cursor="Hand"
                                MouseLeftButtonUp="NavSettings_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavSettingsText" Text="Настройки" FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Status Footer (Row 2) -->
                <Border Grid.Row="2" Padding="16,14"
                        Background="{StaticResource BgDarkerBrush}"
                        BorderBrush="{StaticResource BgLightBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource StatusGreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnectedCountText" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="Подключено: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run x:Name="ConnectedCountRun" Text="0" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                <Run Text=" учеников" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="Сервер TCP :9100 активен" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="17,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT AREA ═══ -->
        <!-- Tab 1: Dashboard Content -->
        <Grid x:Name="DashboardContentArea" Grid.Column="1" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Toolbar -->
            <Border Grid.Row="0" Padding="24,16"
                    BorderBrush="{StaticResource BgLightBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Компьютеры класса" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border CornerRadius="10" Background="{StaticResource AccentBlueMutedBrush}"
                                Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="OnlineBadgeText" Text="0 онлайн" FontSize="11" Foreground="{StaticResource AccentBlueLightBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Timer -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="⏱️" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LessonTimerText" Text="00:00:00" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Student Grid Area -->
            <Grid Grid.Row="1">
                <!-- Empty State -->
                <StackPanel x:Name="EmptyStudentsPanel"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Visible">
                    <Border Width="72" Height="72" CornerRadius="36"
                            Background="{StaticResource BgDarkerBrush}"
                            BorderBrush="{StaticResource BgLightBrush}" BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="💻" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Ожидание подключения компьютеров"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Запустите программу на компьютерах учеников в локальной сети"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBlueBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Авто-обнаружение работает на порту 5555"
                                   FontSize="12" Foreground="{StaticResource AccentBlueLightBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Connected Students ItemsControl -->
                <ScrollViewer x:Name="StudentsScrollViewer" VerticalScrollBarVisibility="Auto" Padding="24,16" Visibility="Collapsed">
                    <ItemsControl x:Name="StudentGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StudentCard}" Width="200" Height="160" Margin="0,0,12,12"
                                        AllowDrop="True" Drop="StudentCard_Drop" Background="Transparent">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Моргнуть экраном (Определить ПК)" Click="ContextIdentify_Click" Tag="{Binding Id}"/>
                                            <MenuItem Header="Начать демку только для этого ПК" Click="ContextDemo_Click" Tag="{Binding Id}"/>
                                            <MenuItem Header="Отправить сообщение..." Click="ContextSendMessage_Click" Tag="{Binding Id}"/>
                                            <MenuItem Header="Заблокировать / Разблокировать" Click="ContextToggleLock_Click" Tag="{Binding Id}"/>
                                            <MenuItem Header="Обновить скриншот" Click="ContextRefreshScreenshot_Click" Tag="{Binding Id}"/>
                                            <MenuItem Header="Передать файл..." Click="ContextSendFile_Click" Tag="{Binding Id}"/>
                                            <Separator/>
                                            <MenuItem Header="Выключить" Click="ContextShutdown_Click" Tag="{Binding Id}"/>
                                            <MenuItem Header="Перезагрузить" Click="ContextRestart_Click" Tag="{Binding Id}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <!-- Thumbnail Screen Area -->
                                        <Border Background="{StaticResource BgDarkerBrush}" CornerRadius="4" Height="80" Margin="0,0,0,10" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="🖥️" FontSize="26"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Opacity="0.3"/>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>

                                        <!-- Name + Status Dot -->
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource StatusGreenBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                <Setter Property="Fill" Value="{StaticResource StatusGrayBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource StatusRedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Status text and IP -->
                                        <StackPanel Orientation="Horizontal" Margin="14,2,0,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text=" • " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding IpAddress}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Floating Preview Panel -->
                <Border x:Name="PreviewPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,24,24" Width="280" Height="180" Background="{StaticResource BgDarkerBrush}"
                        BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="1" CornerRadius="8"
                        Visibility="Collapsed">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="1"/>
                        <Border Background="#99000000" VerticalAlignment="Top" Padding="8,4" CornerRadius="8,8,0,0">
                            <TextBlock Text="Предпросмотр трансляции" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Action Bar -->
            <Border Grid.Row="2" Background="{StaticResource BgDarkBrush}" Padding="24,14,24,4"
                    BorderBrush="{StaticResource BgLightBrush}" BorderThickness="0,1,0,0">
                <WrapPanel>
                    <Button x:Name="BtnDemo" Style="{StaticResource PrimaryButton}" Height="40" Padding="18,0" Margin="0,0,12,10"
                            ToolTip="Транслировать экран или выбранное окно всем ученикам" Click="BtnDemo_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="BtnDemoIcon" Text="▶" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BtnDemoText" Text="Начать демонстрацию" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnLock" Style="{StaticResource SecondaryButton}" Height="40" Padding="18,0" Margin="0,0,12,10"
                            ToolTip="Заблокировать ввод на компьютерах всех учеников для привлечения внимания" Click="BtnLock_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="BtnLockIcon" Text="🔒" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BtnLockText" Text="Заблокировать всех" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMessage" Style="{StaticResource SecondaryButton}" Height="40" Padding="18,0" Margin="0,0,12,10"
                            ToolTip="Отправить текстовое объявление со звуковым сигналом всему классу" Click="BtnMessage_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💬" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Сообщение" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRecord" Style="{StaticResource SecondaryButton}" Height="40" Padding="18,0" Margin="0,0,12,10"
                            ToolTip="Записать видеоурок со звуком (микрофон + системный звук ПК)" Click="BtnRecord_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="BtnRecordIcon" Text="⏺" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BtnRecordText" Text="Начать запись" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnShutdown" Style="{StaticResource DangerButton}" Height="40" Padding="18,0" Margin="0,0,12,10"
                            ToolTip="Дистанционно выключить все подключенные ПК учеников" Click="BtnShutdown_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Выключить всех" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRestart" Style="{StaticResource SecondaryButton}" Height="40" Padding="18,0" Margin="0,0,12,10"
                            ToolTip="Дистанционно перезагрузить компьютеры учеников" Click="BtnRestart_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Перезагрузить всех" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>
        </Grid>

        <!-- Tab 2: Notes Content (Заметки) -->
        <ContentControl x:Name="NotesContentArea" Grid.Column="1" Visibility="Collapsed"/>

        <!-- Tab 3: Recordings Content (Записи) -->
        <ContentControl x:Name="RecordingsContentArea" Grid.Column="1" Visibility="Collapsed"/>

        <!-- Tab 4: Settings Content (Настройки) -->
        <ContentControl x:Name="SettingsContentArea" Grid.Column="1" Visibility="Collapsed"/>
    </Grid>
</UserControl>